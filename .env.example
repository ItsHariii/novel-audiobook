NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
# Server only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
AUDIO_WORKER_SECRET=GENERATE_A_RANDOM_32_BYTE_SECRET
AUDIO_CACHE_MAX_BYTES=750000000
# Signs cover-image proxy URLs. Falls back to SUPABASE_SERVICE_ROLE_KEY, then to a
# per-process secret (cover links then stop working after a restart).
COVER_SIGNING_SECRET=
